{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "lib": ["DOM", "ES2020"],
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "scripts/**/*.ts",
    "triton_viz/static/shell/**/*.ts",
    "triton_viz/static/shell/**/*.d.ts"
  ]
}
