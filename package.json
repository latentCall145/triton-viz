{
  "name": "triton-viz-frontend-shell",
  "private": true,
  "type": "module",
  "scripts": {
    "build:codemirror": "esbuild scripts/codemirror-entry.ts --bundle --format=esm --target=es2020 --outfile=triton_viz/static/vendor/codemirror/codemirror.bundle.js",
    "build:shell": "esbuild triton_viz/static/shell/main.ts --bundle --format=esm --target=es2020 --outfile=triton_viz/static/shell/main.js --external:../vendor/codemirror/codemirror.bundle.js"
  },
  "dependencies": {
    "@codemirror/language": "^6.10.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.39.4",
    "codemirror": "^6.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.27.2"
  }
}
